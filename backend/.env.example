# Local chat model through Ollama's OpenAI-compatible API
LLM_BASE_URL = http://localhost:11434/v1
LLM_API_KEY = ollama
LLM_MODEL = qwen2.5:1.5b

# Gemini (flashcards and quiz). Get a free key at https://aistudio.google.com
GEMINI_API_KEY = your-gemini-api-key
